library(ggplot2)
autoplot(psei_ts, linewidth = 1.2, colour = "steelblue") +
geom_point(aes(x = min_time, y = min_val), color = "red", size = 3) +
geom_point(aes(x = max_time, y = max_val), color = "darkgreen", size = 3) +
annotate(
"label",
x = min_time,
y = min_val,
label = paste("Min:", round(min_val, 2)),
fill = "red",
color = "white",
label.size = 0,
nudge_y = -500
) +
annotate(
"label",
x = max_time,
y = max_val,
label = paste("Max:", round(max_val, 2)),
fill = "lightgreen",
color = "black",
label.size = 0,
nudge_y = 500
) +
labs(
title = "PSEI Price Time Series",
subtitle = "Created by: Romie C. Mabborang & John Carlo N. Elmaguin",
x = "Time",
y = "Price"
) +
theme_minimal(base_size = 13) +
theme(
panel.grid.minor = element_blank()
)
